  "ocaml" {>= "5.0"}
  "dune" {>= "3.13" & >= "3.13"}
  "menhir" {>= "20230608"}
  "alcotest" {>= "1.7.0"}
  "cmdliner" {>= "1.2.0"}
  "yojson" {>= "2.1.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/danielbusing/atp-ocaml.git"
